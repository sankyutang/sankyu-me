---
import { SocialRow } from '@/components/react/primitives'
import { getProfile, getSocialLinks } from '@/lib/data-source'

const [profile, social] = await Promise.all([getProfile(), getSocialLinks()])
---

<footer class="mt-24 border-t" style="border-color: var(--ink-300);">
  <div class="max-w-6xl mx-auto px-5 md:px-8 py-10">
    <div class="grid md:grid-cols-3 gap-8">
      <div>
        <div class="font-display text-[24px] leading-none" style="color: var(--ink-900);">
          sankyu<span style="color: var(--accent);">.</span>me
        </div>
        <p class="mt-3 text-[13px]" style="color: var(--ink-500);">{profile.location}</p>
        <p class="mt-1 text-[13px]" style="color: var(--ink-500); font-family: var(--font-mono);">{profile.email}</p>
      </div>
      <div>
        <div class="kicker mb-3">在别处 · Elsewhere</div>
        <SocialRow items={social} />
      </div>
      <div>
        <div class="kicker mb-3">订阅 · Subscribe</div>
        <p class="text-[13px] mb-3" style="color: var(--ink-700);">
          每周日早上,一封《一人公司周记》。不卖课、不打折、不催更。
        </p>
        <form id="subscribe-form" class="flex gap-2">
          <input
            type="email"
            placeholder="your@email"
            class="flex-1 px-3 py-2 text-[13px]"
            style="background: var(--paper-50); border: 1px solid var(--ink-300); color: var(--ink-800); font-family: var(--font-body);"
          />
          <button type="submit" class="px-3 py-2 text-[13px]" style="background: var(--accent); color: var(--paper-50); font-family: var(--font-body);">
            订阅
          </button>
        </form>
      </div>
    </div>
    <hr class="hand-divider my-8" />
    <div class="flex flex-wrap items-center justify-between gap-3 text-[11px]" style="color: var(--ink-500); font-family: var(--font-mono);">
      <span>© 2020—2026 SANKYU · 仅记录想被记住的事</span>
      <span>BUILT WITH SCISSORS, COFFEE &amp; ⌘+Z</span>
    </div>
  </div>
</footer>

<script>
  document.getElementById('subscribe-form')?.addEventListener('submit', (e) => e.preventDefault())
</script>
