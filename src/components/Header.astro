---
import type { NavItem } from '@/lib/nav'

interface Props {
  siteName: string
  mainNav: NavItem[]
  currentPath: string
}

const { mainNav, currentPath } = Astro.props

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/'
  return currentPath === href || currentPath.startsWith(href + '/')
}

const activeUnderline =
  "url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 80 6' preserveAspectRatio='none'><path d='M2 4 Q 20 1, 40 3 T 78 3' fill='none' stroke='%23c8553d' stroke-width='1.6' stroke-linecap='round'/></svg>\")"
---

<header
  class="sticky top-0 z-30"
  style="background: rgba(245,241,232,0.86); backdrop-filter: blur(8px); border-bottom: 1px solid var(--ink-300);"
>
  <div class="max-w-6xl mx-auto px-5 md:px-8 py-3.5 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 group">
      <span
        class="inline-flex w-8 h-8 items-center justify-center rounded-full text-[15px]"
        style="background: var(--accent); color: var(--paper-50); font-family: var(--font-serif-en); font-style: italic;"
      >
        S
      </span>
      <span class="font-display text-[17px] tracking-tight" style="color: var(--ink-900);">
        sankyu<span style="color: var(--accent);">.</span>me
      </span>
    </a>

    {/* desktop nav */}
    <nav class="hidden md:flex items-center gap-1">
      {
        mainNav.map((item) => {
          const active = isActive(item.href)
          return (
            <a
              href={item.href}
              class="px-3 py-2 text-[14px] relative"
              style={`color: ${active ? 'var(--accent)' : 'var(--ink-700)'}; font-family: var(--font-serif-en), var(--font-body); letter-spacing: 0.01em;`}
            >
              {item.label}
              {active && (
                <span
                  aria-hidden="true"
                  style={`position:absolute; left:10px; right:10px; bottom:2px; height:6px; background-image:${activeUnderline}; background-size:100% 100%; background-repeat:no-repeat;`}
                />
              )}
            </a>
          )
        })
      }
    </nav>

    <div class="flex items-center gap-1">
      <button
        id="theme-toggle"
        class="hidden md:inline-flex items-center justify-center"
        style="width:34px; height:34px; color: var(--ink-700);"
        aria-label="切换主题"
      >
        <svg id="theme-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="12" cy="12" r="5"></circle>
          <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
        </svg>
        <svg id="theme-moon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="display:none">
          <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
        </svg>
      </button>

      {/* mobile toggle */}
      <button id="mobile-menu-btn" class="md:hidden inline-flex flex-col gap-1 p-2" aria-label="menu">
        <span style="width:18px; height:1.5px; background: var(--ink-800);"></span>
        <span style="width:18px; height:1.5px; background: var(--ink-800);"></span>
        <span style="width:12px; height:1.5px; background: var(--ink-800);"></span>
      </button>
    </div>
  </div>

  {/* mobile menu */}
  <div id="mobile-menu" class="md:hidden border-t" style="border-color: var(--ink-300); display:none;">
    <div class="px-5 py-3 grid grid-cols-2 gap-x-2 gap-y-1">
      {
        mainNav.map((item) => {
          const active = isActive(item.href)
          return (
            <a
              href={item.href}
              class="py-2 text-[15px]"
              style={`color: ${active ? 'var(--accent)' : 'var(--ink-800)'}; font-family: var(--font-serif-en), var(--font-body);`}
            >
              {item.label}
            </a>
          )
        })
      }
      <button
        id="mobile-theme-toggle"
        class="py-2 text-[15px] text-left"
        style="color: var(--ink-800); font-family: var(--font-serif-en), var(--font-body);"
      >
        切换主题 · Theme
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn')
  const menu = document.getElementById('mobile-menu')
  btn?.addEventListener('click', () => {
    if (menu) menu.style.display = menu.style.display === 'none' ? 'block' : 'none'
  })

  function syncThemeIcons() {
    const dark = document.documentElement.getAttribute('data-theme') === 'dark'
    const sun = document.getElementById('theme-sun') as HTMLElement | null
    const moon = document.getElementById('theme-moon') as HTMLElement | null
    if (sun) sun.style.display = dark ? 'none' : 'block'
    if (moon) moon.style.display = dark ? 'block' : 'none'
  }
  function toggleTheme() {
    const dark = document.documentElement.getAttribute('data-theme') === 'dark'
    const next = dark ? 'light' : 'dark'
    document.documentElement.setAttribute('data-theme', next)
    try {
      localStorage.setItem('theme', next)
    } catch (e) {}
    syncThemeIcons()
  }
  syncThemeIcons()
  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme)
  document.getElementById('mobile-theme-toggle')?.addEventListener('click', toggleTheme)
</script>
