---
export const prerender = true
import Base from '@/layouts/Base.astro'
import DetailShell from '@/components/DetailShell.astro'
import PagesDetail from '@/components/react/PagesDetail'
import { FauxBody, RelatedGrid } from '@/components/react/shells'
import { PAGE_KIND_META } from '@/components/react/pagebits'
import { pageHref } from '@/lib/links'
import { getPages, getPage, getPosts, getProducts, getPodcasts, getVideos } from '@/lib/data-source'
import { buildCrossRelated } from '@/lib/related'

export async function getStaticPaths() {
  const pages = await getPages()
  return pages.map((p) => ({ params: { slug: p.id } }))
}

const { slug } = Astro.params
const pages = await getPages()
const p = (await getPage(slug!)) ?? pages[0]
const kind = p.kind || 'static'

const staticRelated = pages
  .filter((x) => x.id !== p.id)
  .slice(0, 3)
  .map((x) => ({
    id: x.id,
    kicker: PAGE_KIND_META[x.kind || 'static'].en + ' · ' + (x.category || ''),
    title: x.title_zh,
    excerpt: x.desc,
    meta: x.date,
    href: pageHref(x.id),
  }))

const relatedPages = pages.filter((x) => x.id !== p.id && (x.kind === 'topic' || x.kind === 'collection')).slice(0, 3)
const [posts, products, podcasts, videos] = await Promise.all([getPosts(), getProducts(), getPodcasts(), getVideos()])
const crossRelated = buildCrossRelated('pages', { posts, products, podcasts, videos })
---

<Base title={p.title_zh} description={p.desc}>
  {kind === 'static' ? (
    <DetailShell
      kicker={'PAGE · ' + (p.category || '静态页')}
      zh={p.title_zh}
      en={p.title_en}
      backHref="/pages"
      backLabel="页面列表"
      metaFields={[
        { label: 'PATH', value: '/' + p.id },
        { label: 'KIND', value: '静态页' },
        { label: 'UPDATED', value: p.date },
      ]}
      toc={null}
      hasRelated={staticRelated.length > 0}
    >
      <p class="text-[18px] md:text-[20px] mb-6" style="color: var(--ink-800); line-height: 1.75; font-family: var(--font-wenkai);">
        {p.desc}
      </p>
      <FauxBody paragraphs={4} headings={['', '本月', '上月', '以前']} />

      <RelatedGrid slot="related" items={staticRelated} />
    </DetailShell>
  ) : (
    <PagesDetail page={p} relatedPages={relatedPages} crossRelated={crossRelated} />
  )}
</Base>
