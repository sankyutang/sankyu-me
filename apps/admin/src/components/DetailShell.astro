---
import SiteAvatar from '@/components/SiteAvatar.astro'

interface MetaField {
  label: string
  value: string | number
}
interface TocItem {
  id: string
  label: string
}
interface Props {
  kicker: string
  zh: string
  en?: string
  summary?: string
  authorName?: string
  backHref?: string
  backLabel?: string
  metaFields: MetaField[]
  toc?: TocItem[] | null
  hasRelated?: boolean
  coverSrc?: string
  coverAlt?: string
  shareUrl?: string
}

const {
  kicker,
  zh,
  en,
  summary,
  authorName = '三桥',
  backHref = '/',
  backLabel = '首页',
  metaFields,
  toc = null,
  hasRelated = false,
  coverSrc,
  coverAlt = '',
  shareUrl = '',
} = Astro.props

const xShare = shareUrl
  ? `https://x.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(zh)}`
  : ''

const dateField = metaFields.find((f) => /date|日期/i.test(f.label))
const dateDisplay = dateField ? String(dateField.value) : ''
---

<div class="max-w-[67.5rem] mx-auto px-5 md:px-8 pt-8 md:pt-10 pb-16">
  <a
    href={backHref}
    class="text-[0.875rem] mb-8 hand-underline inline-flex items-center gap-1.5"
    style="color: var(--ink-500);"
  >
    ← 返回 {backLabel}
  </a>

  <div class="grid lg:grid-cols-[2.5rem_minmax(0,1fr)] gap-6 lg:gap-8 items-start">
    {toc && toc.length > 0 ? (
      <nav class="hidden lg:flex flex-col gap-2 sticky top-24 self-start pt-1" aria-label="章节目录">
        {toc.map((t) => (
          <a
            href={'#' + t.id}
            class="block h-[3px] w-3.5 rounded-sm no-underline hover:w-5 transition-all"
            style="background: #d8d8d8;"
            title={t.label}
          >
            <span class="sr-only">{t.label}</span>
          </a>
        ))}
      </nav>
    ) : (
      <div class="hidden lg:block" aria-hidden="true"></div>
    )}

    <article class="min-w-0 max-w-[45rem] mx-auto w-full">
      <header class="mb-6">
        <p class="m-0 mb-3 text-[0.8125rem]" style="color: var(--ink-300);">{kicker}</p>
        <h1
          class="m-0 font-display font-bold text-[1.7rem] md:text-[2.2rem] leading-[1.3]"
          style="color: var(--ink-900); overflow-wrap: anywhere; word-break: break-word;"
        >
          {zh}
        </h1>
        {en && (
          <p class="mt-2 text-[1rem]" style="color: var(--ink-500);">{en}</p>
        )}
        {summary && (
          <p class="mt-4 mb-0 text-[1.05rem]" style="color: var(--ink-500); line-height: 1.75;">
            {summary}
          </p>
        )}
        <div class="mt-5 flex items-center gap-2.5 text-[0.9rem]" style="color: var(--ink-500);">
          <SiteAvatar size="1.75rem" />
          <span>{authorName}</span>
          {dateDisplay && (
            <>
              <span aria-hidden="true">·</span>
              <span>{dateDisplay}</span>
            </>
          )}
        </div>
      </header>

      {coverSrc ? (
        <figure class="cover-frame mb-8 m-0">
          <img
            src={coverSrc}
            alt={coverAlt}
            class="block w-full object-cover"
            style="aspect-ratio: 16 / 9;"
            loading="eager"
          />
        </figure>
      ) : (
        <div class="cover-fallback mb-8" aria-hidden="true">
          <p class="cf-title">{zh}</p>
          <span class="cf-note">排版封面 · 本文无独立封面图</span>
        </div>
      )}

      {toc && toc.length > 0 && (
        <details class="lg:hidden mb-6 rounded-lg border px-4 py-3" style="border-color: var(--paper-300);">
          <summary class="font-medium text-[0.9rem] cursor-pointer" style="color: var(--ink-800);">目录</summary>
          <ul class="mt-3 mb-1 list-none p-0 space-y-2 text-[0.875rem]">
            {toc.map((t) => (
              <li>
                <a href={'#' + t.id} class="hand-underline" style="color: var(--ink-700);">{t.label}</a>
              </li>
            ))}
          </ul>
        </details>
      )}

      <div style="color: var(--ink-800);">
        <slot />
      </div>

      <div class="mt-10 pt-6 border-t flex flex-wrap gap-x-4 gap-y-2 text-[0.875rem]" style="border-color: var(--paper-300); color: var(--ink-500);">
        {shareUrl && (
          <button
            type="button"
            id="copy-page-link"
            class="hand-underline bg-transparent border-0 p-0 cursor-pointer"
            style="color: var(--ink-500); font: inherit;"
            data-url={shareUrl}
          >
            复制链接
          </button>
        )}
        {xShare && (
          <a href={xShare} class="hand-underline" rel="noopener noreferrer" target="_blank">分享到 X</a>
        )}
      </div>

      {hasRelated && (
        <section class="mt-14">
          <hr class="hand-divider mb-6" />
          <h2 class="font-display font-bold text-[1.25rem] mb-5" style="color: var(--ink-900);">相关内容</h2>
          <slot name="related" />
        </section>
      )}
    </article>
  </div>
</div>

<script is:inline>
  ;(function () {
    var btn = document.getElementById('copy-page-link')
    if (!btn) return
    btn.addEventListener('click', function () {
      var url = btn.getAttribute('data-url') || window.location.href
      function done() {
        var prev = btn.textContent
        btn.textContent = '已复制'
        setTimeout(function () { btn.textContent = prev || '复制链接' }, 1600)
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(done).catch(function () {})
      }
    })
  })()
</script>
