---
interface MetaField {
  label: string
  value: string | number
}
interface TocItem {
  id: string
  label: string
}
interface Props {
  kicker: string
  zh: string
  en?: string
  backHref?: string
  backLabel?: string
  metaFields: MetaField[]
  toc?: TocItem[] | null
  hasRelated?: boolean
  coverSrc?: string
  coverAlt?: string
  shareUrl?: string
}

const {
  kicker,
  zh,
  en,
  backHref = '/',
  backLabel = '首页',
  metaFields,
  toc = null,
  hasRelated = false,
  coverSrc,
  coverAlt = '',
  shareUrl = '',
} = Astro.props

const xShare = shareUrl
  ? `https://x.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(zh)}`
  : ''
---

<div class="max-w-6xl mx-auto px-5 md:px-8 pt-10 md:pt-12 pb-16">
  <a
    href={backHref}
    class="text-[0.8125rem] mb-8 hand-underline inline-flex items-center gap-1.5"
    style="color: var(--ink-700);"
  >
    ← 返回 {backLabel}
  </a>

  {coverSrc && (
    <figure
      class="mb-8 overflow-hidden max-w-3xl"
      style="border: 1px solid var(--paper-300); background: var(--paper-200);"
    >
      <img
        src={coverSrc}
        alt={coverAlt}
        class="block w-full object-cover"
        style="aspect-ratio: 16 / 9; max-height: 440px;"
        loading="eager"
      />
    </figure>
  )}

  <header class="mb-8 max-w-3xl">
    <div class="kicker mb-3">{kicker}</div>
    <h1
      class="font-display text-[1.75rem] md:text-[2.35rem] leading-[1.25] tracking-tight"
      style="color: var(--ink-900); overflow-wrap: anywhere; word-break: break-word;"
    >
      {zh}
    </h1>
    {en && (
      <p class="mt-2 text-[1rem] md:text-[1.05rem] font-en" style="color: var(--ink-500);">
        {en}
      </p>
    )}
  </header>

  <hr class="hand-divider mb-8 max-w-3xl" />

  <div class="grid md:grid-cols-[minmax(0,1fr)_13.5rem] gap-10 md:gap-12">
    <article class="min-w-0" style="color: var(--ink-800);">
      <slot />
    </article>

    <aside class="md:sticky md:top-24 md:self-start">
      <div class="kicker mb-3">Meta</div>
      <dl class="text-[0.8125rem] space-y-1.5 mb-7" style="color: var(--ink-700);">
        {metaFields.map((f) => (
          <div class="flex justify-between gap-3 py-1.5 border-b" style="border-color: var(--paper-300);">
            <dt class="font-en" style="color: var(--ink-500); font-size: 0.7rem; letter-spacing: 0.06em;">{f.label}</dt>
            <dd class="text-right" style="overflow-wrap: anywhere;">{f.value}</dd>
          </div>
        ))}
      </dl>

      {toc && toc.length > 0 && (
        <>
          <div class="kicker mb-3">Contents</div>
          <ul class="text-[0.8125rem] space-y-1.5 mb-7 list-none p-0 m-0">
            {toc.map((t, i) => (
              <li>
                <a href={'#' + t.id} class="hand-underline" style="color: var(--ink-700);">
                  {String(i + 1).padStart(2, '0')} · {t.label}
                </a>
              </li>
            ))}
          </ul>
        </>
      )}

      <div class="kicker mb-3">Share</div>
      <div class="flex flex-wrap gap-x-3 gap-y-1 text-[0.75rem]" style="color: var(--ink-700);">
        {shareUrl && (
          <button
            type="button"
            id="copy-page-link"
            class="hand-underline bg-transparent border-0 p-0 cursor-pointer"
            style="color: var(--ink-700); font: inherit;"
            data-url={shareUrl}
          >
            复制链接
          </button>
        )}
        {xShare && (
          <a href={xShare} class="hand-underline" rel="noopener noreferrer" target="_blank">X</a>
        )}
      </div>
    </aside>
  </div>

  {hasRelated && (
    <section class="mt-16">
      <hr class="hand-divider mb-8" />
      <div class="kicker mb-2">Related</div>
      <h3 class="font-display text-[1.35rem] md:text-[1.5rem] leading-tight mb-6" style="color: var(--ink-900);">
        相关内容
      </h3>
      <slot name="related" />
    </section>
  )}
</div>

<script is:inline>
  ;(function () {
    var btn = document.getElementById('copy-page-link')
    if (!btn) return
    btn.addEventListener('click', function () {
      var url = btn.getAttribute('data-url') || window.location.href
      function done() {
        var prev = btn.textContent
        btn.textContent = '已复制'
        setTimeout(function () { btn.textContent = prev || '复制链接' }, 1600)
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(done).catch(function () {})
      }
    })
  })()
</script>
