---
interface Props {
  kicker: string
  en: string
  blurb?: string
  count?: number | null
  countLabel?: string
  wide?: boolean
}

const { kicker, en, blurb, count = null, countLabel = 'TOTAL', wide = false } = Astro.props
---

<div class={(wide ? 'max-w-[67.5rem]' : 'max-w-3xl') + ' mx-auto px-5 md:px-8 pt-10 md:pt-12 pb-16'}>
  <header class="mb-8 md:mb-10 grid md:grid-cols-[1fr_auto] gap-5 md:items-end">
    <div>
      <div class="kicker mb-2">{kicker}</div>
      <h1 class="font-display font-bold text-[1.85rem] md:text-[2.25rem] leading-[1.2] tracking-tight" style="color: var(--ink-900);">
        {en}
      </h1>
      {blurb && (
        <p class="mt-3 text-[0.95rem] md:text-[1rem] max-w-[40em]" style="color: var(--ink-500); line-height: 1.8;">
          {blurb}
        </p>
      )}
    </div>
    {count != null && (
      <div class="text-right inline-flex md:flex-col items-baseline md:items-end gap-2 md:gap-1">
        <span class="font-en text-[1.75rem] md:text-[2rem] leading-none font-semibold" style="color: var(--accent);">
          {count}
        </span>
        <span class="kicker">{countLabel}</span>
      </div>
    )}
  </header>
  <hr class="hand-divider mb-8" />
  <slot />
</div>
