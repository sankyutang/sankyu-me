---
import '@/styles/global.css'
interface Props { title?: string }
const { title = 'Admin' } = Astro.props
const pathname = Astro.url.pathname
const links = [
  { href: '/admin', label: 'Dashboard' },
  { href: '/admin/posts', label: 'Posts' },
  { href: '/admin/pages', label: 'Pages' },
  { href: '/admin/works', label: 'Works' },
  { href: '/admin/products', label: 'Products' },
  { href: '/admin/podcasts', label: 'Podcasts' },
  { href: '/admin/videos', label: 'Videos' },
  { href: '/admin/site-settings', label: 'Site Settings' },
]
---
<!doctype html>
<html lang="zh-CN" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Admin</title>
  </head>
  <body class="antialiased bg-background text-foreground">
    <div class="flex min-h-screen">
      <aside class="w-56 border-r border-border p-4">
        <div class="font-semibold mb-6">sankyume admin</div>
        <nav class="flex flex-col gap-1 text-sm">
          {links.map((l) => (
            <a
              href={l.href}
              class={`px-3 py-2 rounded ${
                (l.href === '/admin' && pathname === '/admin') ||
                (l.href !== '/admin' && pathname.startsWith(l.href))
                  ? 'bg-muted text-foreground'
                  : 'text-muted-foreground hover:bg-muted/50'
              }`}
            >{l.label}</a>
          ))}
        </nav>
        <form method="POST" action="/api/republish" class="mt-6">
          <button class="text-xs text-muted-foreground underline" type="submit">触发整站重发</button>
        </form>
      </aside>
      <div class="flex-1">
        <header class="h-14 border-b border-border px-6 flex items-center">
          <h1 class="font-medium">{title}</h1>
        </header>
        <main class="p-6 max-w-5xl">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
