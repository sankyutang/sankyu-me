---
import '@/styles/paper.css'
import { SocialRow } from '@/components/react/primitives'
import { adaptProfile, adaptSocial } from '@/lib/adapt'
import type { SiteSettings } from '@/lib/db/types'

interface Props {
  settings: SiteSettings
  env: { siteUrl: string; assetBase: string }
  pathname?: string
  isHome?: boolean
  title?: string
  description?: string
  ogImage?: string
  canonicalUrl?: string
}

const {
  settings,
  env,
  pathname = '/',
  title,
  description,
  ogImage,
  canonicalUrl,
} = Astro.props

const profile = adaptProfile(settings)
const social = adaptSocial(settings)

const siteName = settings.siteName || 'sankyu.me'
const pageTitle = title ? `${title} · ${siteName}` : settings.defaultSeoTitle || siteName
const desc = description || settings.defaultSeoDescription || settings.siteDescription || profile.intro_zh
const siteUrl = (settings.siteUrl || env.siteUrl || 'https://sankyu.me').replace(/\/$/, '')
const og = ogImage || settings.defaultOgImage || `${siteUrl}/images/og-default.png`
const canonical = canonicalUrl || `${siteUrl}${pathname}`

const nav = [
  { label: 'Home', href: '/' },
  { label: 'Posts', href: '/posts' },
  { label: 'Products', href: '/products' },
  { label: 'Media', href: '/media' },
  { label: 'Pages', href: '/pages' },
  { label: 'About', href: '/about' },
]
function isActive(href: string): boolean {
  if (href === '/') return pathname === '/'
  return pathname === href || pathname.startsWith(href + '/')
}
const activeUnderline =
  "url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 80 6' preserveAspectRatio='none'><path d='M2 4 Q 20 1, 40 3 T 78 3' fill='none' stroke='%23c8553d' stroke-width='1.6' stroke-linecap='round'/></svg>\")"
---

<!doctype html>
<html lang="zh-CN" data-theme="light" data-font="serif">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400;1,6..72,500&family=Noto+Serif+SC:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Caveat:wght@500;600&family=Manrope:wght@400;500;600;700&display=swap"
    />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-webfont@1.7.0/style.css" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={og} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme')
          document.documentElement.setAttribute('data-theme', t === 'dark' ? 'dark' : 'light')
        } catch (e) {}
      })()
    </script>
  </head>
  <body class="paper-bg antialiased">
    <header
      class="sticky top-0 z-30"
      style="background: rgba(245,241,232,0.86); backdrop-filter: blur(8px); border-bottom: 1px solid var(--ink-300);"
    >
      <div class="max-w-6xl mx-auto px-5 md:px-8 py-3.5 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 group">
          <span
            class="inline-flex w-8 h-8 items-center justify-center rounded-full text-[15px]"
            style="background: var(--accent); color: var(--paper-50); font-family: var(--font-serif-en); font-style: italic;"
          >S</span>
          <span class="font-display text-[17px] tracking-tight" style="color: var(--ink-900);">
            sankyu<span style="color: var(--accent);">.</span>me
          </span>
        </a>

        <nav class="hidden md:flex items-center gap-1">
          {
            nav.map((item) => {
              const active = isActive(item.href)
              return (
                <a
                  href={item.href}
                  class="px-3 py-2 text-[14px] relative"
                  style={`color: ${active ? 'var(--accent)' : 'var(--ink-700)'}; font-family: var(--font-serif-en), var(--font-body); letter-spacing: 0.01em;`}
                >
                  {item.label}
                  {active && (
                    <span
                      aria-hidden="true"
                      style={`position:absolute; left:10px; right:10px; bottom:2px; height:6px; background-image:${activeUnderline}; background-size:100% 100%; background-repeat:no-repeat;`}
                    />
                  )}
                </a>
              )
            })
          }
        </nav>

        <div class="flex items-center gap-1">
          <button id="theme-toggle" class="hidden md:inline-flex items-center justify-center" style="width:34px; height:34px; color: var(--ink-700);" aria-label="切换主题">
            <svg id="theme-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="12" cy="12" r="5"></circle>
              <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
            </svg>
            <svg id="theme-moon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="display:none">
              <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
            </svg>
          </button>
          <button id="mobile-menu-btn" class="md:hidden inline-flex flex-col gap-1 p-2" aria-label="menu">
            <span style="width:18px; height:1.5px; background: var(--ink-800);"></span>
            <span style="width:18px; height:1.5px; background: var(--ink-800);"></span>
            <span style="width:12px; height:1.5px; background: var(--ink-800);"></span>
          </button>
        </div>
      </div>

      <div id="mobile-menu" class="md:hidden border-t" style="border-color: var(--ink-300); display:none;">
        <div class="px-5 py-3 grid grid-cols-2 gap-x-2 gap-y-1">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="py-2 text-[15px]"
                style={`color: ${isActive(item.href) ? 'var(--accent)' : 'var(--ink-800)'}; font-family: var(--font-serif-en), var(--font-body);`}
              >
                {item.label}
              </a>
            ))
          }
          <button id="mobile-theme-toggle" class="py-2 text-[15px] text-left" style="color: var(--ink-800); font-family: var(--font-serif-en), var(--font-body);">
            切换主题 · Theme
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-24 border-t" style="border-color: var(--ink-300);">
      <div class="max-w-6xl mx-auto px-5 md:px-8 py-10">
        <div class="grid md:grid-cols-3 gap-8">
          <div>
            <div class="font-display text-[24px] leading-none" style="color: var(--ink-900);">
              sankyu<span style="color: var(--accent);">.</span>me
            </div>
            <p class="mt-3 text-[13px]" style="color: var(--ink-500);">{profile.location}</p>
            <p class="mt-1 text-[13px]" style="color: var(--ink-500); font-family: var(--font-mono);">{profile.email}</p>
          </div>
          <div>
            <div class="kicker mb-3">在别处 · Elsewhere</div>
            <SocialRow items={social} />
          </div>
          <div>
            <div class="kicker mb-3">订阅 · Subscribe</div>
            <p class="text-[13px] mb-3" style="color: var(--ink-700);">
              每周日早上,一封《一人公司周记》。不卖课、不打折、不催更。
            </p>
            <form id="subscribe-form" class="flex gap-2">
              <input type="email" placeholder="your@email" class="flex-1 px-3 py-2 text-[13px]" style="background: var(--paper-50); border: 1px solid var(--ink-300); color: var(--ink-800); font-family: var(--font-body);" />
              <button type="submit" class="px-3 py-2 text-[13px]" style="background: var(--accent); color: var(--paper-50); font-family: var(--font-body);">订阅</button>
            </form>
          </div>
        </div>
        <hr class="hand-divider my-8" />
        <div class="flex flex-wrap items-center justify-between gap-3 text-[11px]" style="color: var(--ink-500); font-family: var(--font-mono);">
          <span>© 2020—2026 SANKYU · 仅记录想被记住的事</span>
          <span>BUILT WITH SCISSORS, COFFEE &amp; ⌘+Z</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      ;(function () {
        // mobile menu
        var btn = document.getElementById('mobile-menu-btn')
        var menu = document.getElementById('mobile-menu')
        if (btn && menu) btn.addEventListener('click', function () {
          menu.style.display = menu.style.display === 'none' ? 'block' : 'none'
        })
        // theme toggle
        function sync() {
          var dark = document.documentElement.getAttribute('data-theme') === 'dark'
          var sun = document.getElementById('theme-sun')
          var moon = document.getElementById('theme-moon')
          if (sun) sun.style.display = dark ? 'none' : 'block'
          if (moon) moon.style.display = dark ? 'block' : 'none'
        }
        function toggle() {
          var dark = document.documentElement.getAttribute('data-theme') === 'dark'
          var next = dark ? 'light' : 'dark'
          document.documentElement.setAttribute('data-theme', next)
          try { localStorage.setItem('theme', next) } catch (e) {}
          sync()
        }
        sync()
        var t1 = document.getElementById('theme-toggle')
        var t2 = document.getElementById('mobile-theme-toggle')
        if (t1) t1.addEventListener('click', toggle)
        if (t2) t2.addEventListener('click', toggle)
        // subscribe (no-op)
        var sf = document.getElementById('subscribe-form')
        if (sf) sf.addEventListener('submit', function (e) { e.preventDefault() })
        // reveal
        function reveal() {
          document.body.classList.add('js-ready')
          var els = [].slice.call(document.querySelectorAll('.reveal'))
          if (!('IntersectionObserver' in window) || !els.length) {
            els.forEach(function (el) { el.classList.add('in') })
            return
          }
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) {
              if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target) }
            })
          }, { threshold: 0.05, rootMargin: '0px 0px -40px 0px' })
          els.forEach(function (el) { io.observe(el) })
          setTimeout(function () {
            document.querySelectorAll('.reveal:not(.in)').forEach(function (el) { el.classList.add('in') })
          }, 1200)
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', reveal)
        else reveal()
      })()
    </script>
  </body>
</html>
