---
import '@/styles/paper.css'
import { SocialRow } from '@/components/react/primitives'
import { adaptProfile, adaptSocial } from '@/lib/adapt'
import type { SiteSettings } from '@/lib/db/types'

interface Props {
  settings: SiteSettings
  env: { siteUrl: string; assetBase: string }
  pathname?: string
  isHome?: boolean
  title?: string
  description?: string
  ogImage?: string
  canonicalUrl?: string
}

const {
  settings,
  env,
  pathname = '/',
  title,
  description,
  ogImage,
  canonicalUrl,
} = Astro.props

const profile = adaptProfile(settings)
const social = adaptSocial(settings)

const siteName = settings.siteName || 'sankyu.me'
const pageTitle = title ? `${title} · ${siteName}` : settings.defaultSeoTitle || siteName
const desc = description || settings.defaultSeoDescription || settings.siteDescription || profile.intro_zh
const siteUrl = (settings.siteUrl || env.siteUrl || 'https://sankyu.me').replace(/\/$/, '')
const rawOg = ogImage || settings.defaultOgImage || `${siteUrl}/images/og-default.png`
const og = /^https?:\/\//.test(rawOg) ? rawOg : `${siteUrl}${rawOg.startsWith('/') ? rawOg : `/${rawOg}`}`
const canonical = canonicalUrl || `${siteUrl}${pathname}`

/** Real public routes — labels match approved fankai-inspired nav */
const nav = [
  { label: '首页', href: '/' },
  { label: '文章', href: '/posts' },
  { label: '产品', href: '/products' },
  { label: '媒体', href: '/media' },
  { label: '页面', href: '/pages' },
  { label: '关于', href: '/about' },
]
function isActive(href: string): boolean {
  if (href === '/') return pathname === '/'
  return pathname === href || pathname.startsWith(href + '/')
}
---

<!doctype html>
<html lang="zh-CN" data-theme="light" data-font="sans">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={og} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={og} />
  </head>
  <body class="paper-bg antialiased">
    <header class="site-header sticky top-0 z-30" style="background: rgba(255,255,255,0.96); border-bottom: 1px solid var(--paper-300);">
      <div class="site-header-bar max-w-[67.5rem] mx-auto px-5 md:px-8 min-h-16 grid grid-cols-[2.5rem_1fr_auto] items-center gap-3">
        <a
          href="/"
          class="mark-circle inline-flex items-center justify-center w-8 h-8 rounded-full text-[0.8rem] font-bold no-underline"
          style="background: var(--ink-900); color: #fff;"
          aria-label={`${siteName} 首页`}
        >
          桥
        </a>
        <a
          href="/"
          class="site-brand justify-self-center font-display font-bold text-[1.25rem] md:text-[1.35rem] tracking-tight no-underline"
          style="color: var(--ink-900);"
        >
          {siteName}
        </a>
        <div class="justify-self-end flex items-center gap-2">
          <a class="btn-cta header-cta-desktop" href="/about">关于 / 合作</a>
          <button
            id="mobile-menu-btn"
            class="header-menu-btn inline-flex items-center justify-center w-11 h-11 rounded-full"
            style="border: 1px solid var(--paper-300); background: var(--paper-50); color: var(--ink-800);"
            aria-label="打开菜单"
            aria-expanded="false"
            aria-controls="mobile-menu"
            type="button"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h10" stroke-linecap="round"></path>
            </svg>
          </button>
        </div>
      </div>

      <nav class="site-nav header-nav-desktop max-w-[67.5rem] mx-auto px-5 md:px-8 pb-3 justify-center flex-wrap gap-x-5 gap-y-1" aria-label="主导航">
        {
          nav.map((item) => {
            const active = isActive(item.href)
            return (
              <a
                href={item.href}
                class="py-1 text-[0.95rem] no-underline"
                style={`color: var(--ink-900); font-weight: ${active ? '600' : '500'}; box-shadow: ${active ? 'inset 0 -2px 0 #cfcfcf' : 'none'};`}
                aria-current={active ? 'page' : undefined}
              >
                {item.label}
              </a>
            )
          })
        }
      </nav>

      <div id="mobile-menu" class="header-menu-panel border-t" style="border-color: var(--paper-300); display:none;" hidden>
        <div class="px-5 py-3 flex flex-col gap-1">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="py-2.5 text-[1rem] no-underline"
                style={`color: ${isActive(item.href) ? 'var(--ink-900)' : 'var(--ink-700)'}; font-weight: ${isActive(item.href) ? '600' : '500'};`}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <a class="btn-cta mt-2 w-full" href="/about">关于 / 合作</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-16 border-t" style="border-color: var(--paper-300);">
      <div class="max-w-[67.5rem] mx-auto px-5 md:px-8 py-10">
        <div class="grid md:grid-cols-[1.4fr_1fr] gap-8 items-start">
          <div>
            <div class="font-display font-bold text-[1.35rem]" style="color: var(--ink-900);">
              {profile.name_zh} · {siteName}
            </div>
            <p class="mt-3 text-[0.92rem] max-w-[36em]" style="color: var(--ink-500); line-height: 1.7;">
              {profile.intro_zh}
            </p>
            <p class="mt-2 text-[0.85rem]" style="color: var(--ink-300);">{profile.location}</p>
          </div>
          <div class="flex flex-col items-start gap-3">
            {/* Subscribe form lands from PR #2 rebase — until then, real about/coop entry only */}
            <a class="btn-cta" href="/about">了解合作</a>
            <div class="text-[0.88rem]" style="color: var(--ink-500);">
              <SocialRow items={social} />
            </div>
          </div>
        </div>
        <hr class="hand-divider my-8" />
        <div class="flex flex-wrap items-center justify-between gap-3 text-[0.78rem]" style="color: var(--ink-300);">
          <span>© Sankyu Tang</span>
          <span>{profile.location}</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      ;(function () {
        var btn = document.getElementById('mobile-menu-btn')
        var menu = document.getElementById('mobile-menu')
        if (!btn || !menu) return
        function setOpen(open) {
          menu.style.display = open ? 'block' : 'none'
          if (open) menu.removeAttribute('hidden')
          else menu.setAttribute('hidden', '')
          btn.setAttribute('aria-expanded', open ? 'true' : 'false')
          btn.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单')
        }
        btn.addEventListener('click', function () {
          setOpen(menu.style.display !== 'block')
        })
        btn.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault()
            setOpen(menu.style.display !== 'block')
          }
        })
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && menu.style.display === 'block') {
            setOpen(false)
            btn.focus()
          }
        })
      })()
    </script>
  </body>
</html>
