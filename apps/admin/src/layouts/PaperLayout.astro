---
import '@/styles/paper.css'
import { SocialRow } from '@/components/react/primitives'
import { adaptProfile, adaptSocial } from '@/lib/adapt'
import type { SiteSettings } from '@/lib/db/types'

interface Props {
  settings: SiteSettings
  env: { siteUrl: string; assetBase: string }
  pathname?: string
  isHome?: boolean
  title?: string
  description?: string
  ogImage?: string
  canonicalUrl?: string
}

const {
  settings,
  env,
  pathname = '/',
  title,
  description,
  ogImage,
  canonicalUrl,
} = Astro.props

const profile = adaptProfile(settings)
const social = adaptSocial(settings)

const siteName = settings.siteName || 'sankyu.me'
const pageTitle = title ? `${title} · ${siteName}` : settings.defaultSeoTitle || siteName
const desc = description || settings.defaultSeoDescription || settings.siteDescription || profile.intro_zh
const siteUrl = (settings.siteUrl || env.siteUrl || 'https://sankyu.me').replace(/\/$/, '')
const rawOg = ogImage || settings.defaultOgImage || `${siteUrl}/images/og-default.png`
const og = /^https?:\/\//.test(rawOg) ? rawOg : `${siteUrl}${rawOg.startsWith('/') ? rawOg : `/${rawOg}`}`
const canonical = canonicalUrl || `${siteUrl}${pathname}`

/** Real public routes — keep pages; labels cleaned for editorial UI */
const nav = [
  { label: '首页', href: '/' },
  { label: '文章', href: '/posts' },
  { label: '产品', href: '/products' },
  { label: '媒体', href: '/media' },
  { label: '页面', href: '/pages' },
  { label: '关于', href: '/about' },
]
function isActive(href: string): boolean {
  if (href === '/') return pathname === '/'
  return pathname === href || pathname.startsWith(href + '/')
}
---

<!doctype html>
<html lang="zh-CN" data-theme="light" data-font="sans">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={og} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={og} />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme')
          document.documentElement.setAttribute('data-theme', t === 'dark' ? 'dark' : 'light')
        } catch (e) {}
      })()
    </script>
  </head>
  <body class="paper-bg antialiased">
    <header class="sticky top-0 z-30" style="background: rgba(250,250,248,0.92); backdrop-filter: blur(8px); border-bottom: 1px solid var(--paper-300);">
      <div class="max-w-6xl mx-auto px-5 md:px-8 py-3.5 flex items-center justify-between gap-4">
        <a href="/" class="font-en font-semibold text-[1.05rem] tracking-tight" style="color: var(--ink-900);">
          sankyu<span style="color: var(--accent);">.</span>me
        </a>

        <nav class="hidden md:flex items-center gap-1" aria-label="主导航">
          {
            nav.map((item) => {
              const active = isActive(item.href)
              return (
                <a
                  href={item.href}
                  class="px-2.5 py-1.5 text-[0.875rem]"
                  style={`color: ${active ? 'var(--ink-900)' : 'var(--ink-500)'}; font-weight: ${active ? '500' : '400'}; box-shadow: ${active ? 'inset 0 -2px 0 var(--accent)' : 'none'};`}
                  aria-current={active ? 'page' : undefined}
                >
                  {item.label}
                </a>
              )
            })
          }
        </nav>

        <div class="flex items-center gap-1">
          <button id="theme-toggle" class="hidden md:inline-flex items-center justify-center" style="width:34px; height:34px; color: var(--ink-700);" aria-label="切换主题" type="button">
            <svg id="theme-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="12" cy="12" r="5"></circle>
              <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
            </svg>
            <svg id="theme-moon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="display:none" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
            </svg>
          </button>
          <button id="mobile-menu-btn" class="md:hidden inline-flex flex-col gap-1.5 p-2" aria-label="打开菜单" aria-expanded="false" aria-controls="mobile-menu" type="button">
            <span style="width:18px; height:1.5px; background: var(--ink-800); display:block;"></span>
            <span style="width:18px; height:1.5px; background: var(--ink-800); display:block;"></span>
            <span style="width:12px; height:1.5px; background: var(--ink-800); display:block;"></span>
          </button>
        </div>
      </div>

      <div id="mobile-menu" class="md:hidden border-t" style="border-color: var(--paper-300); display:none;" hidden>
        <div class="px-5 py-3 grid grid-cols-2 gap-x-2 gap-y-1">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="py-2 text-[0.95rem]"
                style={`color: ${isActive(item.href) ? 'var(--ink-900)' : 'var(--ink-700)'}; font-weight: ${isActive(item.href) ? '500' : '400'};`}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <button id="mobile-theme-toggle" class="py-2 text-[0.95rem] text-left" style="color: var(--ink-700);" type="button">
            切换主题
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-20 border-t" style="border-color: var(--paper-300);">
      <div class="max-w-6xl mx-auto px-5 md:px-8 py-10">
        <div class="grid md:grid-cols-3 gap-8">
          <div>
            <div class="font-en font-semibold text-[1.15rem]" style="color: var(--ink-900);">
              sankyu<span style="color: var(--accent);">.</span>me
            </div>
            <p class="mt-3 text-[0.8125rem]" style="color: var(--ink-500);">{profile.location}</p>
            <p class="mt-2 text-[0.8125rem]" style="color: var(--ink-500);">
              <a href="/about" class="hand-underline">关于三桥</a>
            </p>
          </div>
          <div>
            <div class="kicker mb-3">Platforms</div>
            <SocialRow items={social} />
          </div>
          <div>
            <div class="kicker mb-3">Collaborate</div>
            <p class="text-[0.8125rem]" style="color: var(--ink-700); line-height: 1.7;">
              AI 咨询、FDE 与一人公司相关话题，见
              <a href="/about" class="hand-underline">关于页</a>。
            </p>
          </div>
        </div>
        <hr class="hand-divider my-8" />
        <div class="flex flex-wrap items-center justify-between gap-3 text-[0.75rem] font-en" style="color: var(--ink-500);">
          <span>© Sankyu Tang</span>
          <span>{profile.location}</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      ;(function () {
        var btn = document.getElementById('mobile-menu-btn')
        var menu = document.getElementById('mobile-menu')
        if (btn && menu) {
          btn.addEventListener('click', function () {
            var open = menu.style.display !== 'block'
            menu.style.display = open ? 'block' : 'none'
            if (open) menu.removeAttribute('hidden')
            else menu.setAttribute('hidden', '')
            btn.setAttribute('aria-expanded', open ? 'true' : 'false')
          })
        }
        function sync() {
          var dark = document.documentElement.getAttribute('data-theme') === 'dark'
          var sun = document.getElementById('theme-sun')
          var moon = document.getElementById('theme-moon')
          if (sun) sun.style.display = dark ? 'none' : 'block'
          if (moon) moon.style.display = dark ? 'block' : 'none'
        }
        function toggle() {
          var dark = document.documentElement.getAttribute('data-theme') === 'dark'
          var next = dark ? 'light' : 'dark'
          document.documentElement.setAttribute('data-theme', next)
          try { localStorage.setItem('theme', next) } catch (e) {}
          sync()
        }
        sync()
        var t1 = document.getElementById('theme-toggle')
        var t2 = document.getElementById('mobile-theme-toggle')
        if (t1) t1.addEventListener('click', toggle)
        if (t2) t2.addEventListener('click', toggle)
      })()
    </script>
  </body>
</html>
