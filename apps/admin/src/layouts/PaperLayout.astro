---
import '@/styles/paper.css'
import { SocialRow } from '@/components/react/primitives'
import { adaptProfile, adaptSocial } from '@/lib/adapt'
import type { SiteSettings } from '@/lib/db/types'
import { SITE_POSITIONING, firstNonEmpty } from '@/lib/seo/defaults'

interface Props {
  settings: SiteSettings
  env: { siteUrl: string; assetBase: string }
  pathname?: string
  isHome?: boolean
  title?: string
  description?: string
  ogImage?: string
  canonicalUrl?: string
}

const {
  settings,
  env,
  pathname = '/',
  title,
  description,
  ogImage,
  canonicalUrl,
} = Astro.props

const profile = adaptProfile(settings)
const social = adaptSocial(settings)

const siteName = settings.siteName || 'sankyu.me'
const pageTitle = title
  ? `${title} · ${siteName}`
  : firstNonEmpty(settings.defaultSeoTitle, SITE_POSITIONING.defaultSeoTitle, siteName)
const desc = firstNonEmpty(
  description,
  settings.defaultSeoDescription,
  settings.siteDescription,
  profile.intro_zh,
  SITE_POSITIONING.defaultSeoDescription
)
const siteUrl = (settings.siteUrl || env.siteUrl || 'https://sankyu.me').replace(/\/$/, '')
const rawOg = ogImage || settings.defaultOgImage || `${siteUrl}/images/og-default.png`
const og = /^https?:\/\//.test(rawOg) ? rawOg : `${siteUrl}${rawOg.startsWith('/') ? rawOg : `/${rawOg}`}`
const canonical = canonicalUrl || `${siteUrl}${pathname}`

/** Real public routes — labels match approved fankai-inspired nav */
const nav = [
  { label: '首页', href: '/' },
  { label: '文章', href: '/posts' },
  { label: '产品', href: '/products' },
  { label: '媒体', href: '/media' },
  { label: '页面', href: '/pages' },
  { label: '关于', href: '/about' },
]
function isActive(href: string): boolean {
  if (href === '/') return pathname === '/'
  return pathname === href || pathname.startsWith(href + '/')
}
---

<!doctype html>
<html lang="zh-CN" data-theme="light" data-font="sans">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={og} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={og} />
  </head>
  <body class="paper-bg antialiased">
    <header class="site-header sticky top-0 z-30" style="background: rgba(255,255,255,0.96); border-bottom: 1px solid var(--paper-300);">
      <div class="site-header-bar max-w-[67.5rem] mx-auto px-5 md:px-8 min-h-16 grid grid-cols-[2.5rem_1fr_auto] items-center gap-3">
        <a
          href="/"
          class="mark-circle inline-flex items-center justify-center w-8 h-8 rounded-full text-[0.8rem] font-bold no-underline"
          style="background: var(--ink-900); color: #fff;"
          aria-label={`${siteName} 首页`}
        >
          桥
        </a>
        <a
          href="/"
          class="site-brand justify-self-center font-display font-bold text-[1.25rem] md:text-[1.35rem] tracking-tight no-underline"
          style="color: var(--ink-900);"
        >
          {siteName}
        </a>
        <div class="justify-self-end flex items-center gap-2">
          <a class="btn-cta header-cta-desktop" href="/about">关于 / 合作</a>
          <button
            id="mobile-menu-btn"
            class="header-menu-btn inline-flex items-center justify-center w-11 h-11 rounded-full"
            style="border: 1px solid var(--paper-300); background: var(--paper-50); color: var(--ink-800);"
            aria-label="打开菜单"
            aria-expanded="false"
            aria-controls="mobile-menu"
            type="button"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h10" stroke-linecap="round"></path>
            </svg>
          </button>
        </div>
      </div>

      <nav class="site-nav header-nav-desktop max-w-[67.5rem] mx-auto px-5 md:px-8 pb-3 justify-center flex-wrap gap-x-5 gap-y-1" aria-label="主导航">
        {
          nav.map((item) => {
            const active = isActive(item.href)
            return (
              <a
                href={item.href}
                class="py-1 text-[0.95rem] no-underline"
                style={`color: var(--ink-900); font-weight: ${active ? '600' : '500'}; box-shadow: ${active ? 'inset 0 -2px 0 #cfcfcf' : 'none'};`}
                aria-current={active ? 'page' : undefined}
              >
                {item.label}
              </a>
            )
          })
        }
      </nav>

      <div id="mobile-menu" class="header-menu-panel border-t" style="border-color: var(--paper-300); display:none;" hidden>
        <div class="px-5 py-3 flex flex-col gap-1">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="py-2.5 text-[1rem] no-underline"
                style={`color: ${isActive(item.href) ? 'var(--ink-900)' : 'var(--ink-700)'}; font-weight: ${isActive(item.href) ? '600' : '500'};`}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <a class="btn-cta mt-2 w-full" href="/about">关于 / 合作</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-16 border-t" style="border-color: var(--paper-300);">
      <div class="max-w-[67.5rem] mx-auto px-5 md:px-8 py-10">
        <div class="grid md:grid-cols-[1.35fr_1fr_1fr] gap-8 items-start">
          <div>
            <div class="font-display font-bold text-[1.35rem]" style="color: var(--ink-900);">
              {profile.name_zh} · {siteName}
            </div>
            <p class="mt-3 text-[0.92rem] max-w-[36em]" style="color: var(--ink-500); line-height: 1.7;">
              {profile.intro_zh}
            </p>
            <p class="mt-2 text-[0.85rem]" style="color: var(--ink-300);">{profile.location}</p>
            <div class="mt-4">
              <a class="btn-cta" href="/about">了解合作</a>
            </div>
          </div>
          <div>
            <div class="kicker mb-3">常用平台</div>
            <div class="text-[0.88rem]" style="color: var(--ink-500);">
              <SocialRow items={social} />
            </div>
          </div>
          <div>
            <div class="kicker mb-3">订阅更新</div>
            <p class="text-[0.88rem] mb-3 m-0" style="color: var(--ink-500); line-height: 1.65;">
              留下邮箱，接收一人公司相关更新。
            </p>
            <form id="subscribe-form" class="subscribe-form flex flex-col gap-2" novalidate>
              <div class="flex gap-2">
                <input
                  id="subscribe-email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  placeholder="your@email"
                  class="subscribe-input flex-1 min-w-0 px-3 py-2 text-[0.875rem]"
                  style="background: var(--paper-50); border: 1px solid var(--paper-300); color: var(--ink-800); border-radius: 999px;"
                />
                <button id="subscribe-submit" type="submit" class="btn-cta shrink-0">订阅</button>
              </div>
              <!-- honeypot: leave empty -->
              <input type="text" name="website" id="subscribe-website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;height:0;width:0;" />
              <p id="subscribe-status" class="text-[0.78rem] m-0" style="color: var(--ink-300); min-height: 1.2em;" role="status" aria-live="polite"></p>
              <p class="text-[0.75rem] m-0" style="color: var(--ink-300); line-height: 1.5;">
                邮箱仅用于站长发送的更新通知，不会自动营销。
              </p>
            </form>
          </div>
        </div>
        <hr class="hand-divider my-8" />
        <div class="flex flex-wrap items-center justify-between gap-3 text-[0.78rem]" style="color: var(--ink-300);">
          <span>© Sankyu Tang</span>
          <span>{profile.location}</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      ;(function () {
        var btn = document.getElementById('mobile-menu-btn')
        var menu = document.getElementById('mobile-menu')
        if (btn && menu) {
          function setOpen(open) {
            menu.style.display = open ? 'block' : 'none'
            if (open) menu.removeAttribute('hidden')
            else menu.setAttribute('hidden', '')
            btn.setAttribute('aria-expanded', open ? 'true' : 'false')
            btn.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单')
          }
          btn.addEventListener('click', function () {
            setOpen(menu.style.display !== 'block')
          })
          btn.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault()
              setOpen(menu.style.display !== 'block')
            }
          })
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && menu.style.display === 'block') {
              setOpen(false)
              btn.focus()
            }
          })
        }

        // Real subscribe → POST /api/subscribe (site-worker on public origin). Status from API only.
        function bindSubscribe(form) {
          if (!form || form.getAttribute('data-bound') === '1') return
          form.setAttribute('data-bound', '1')
          form.addEventListener('submit', function (e) {
            e.preventDefault()
            var emailEl = form.querySelector('[name="email"]')
            var websiteEl = form.querySelector('[name="website"]')
            var statusEl = form.querySelector('[data-subscribe-status], #subscribe-status')
            var submitEl = form.querySelector('[type="submit"]')
            var email = emailEl && 'value' in emailEl ? String(emailEl.value || '').trim() : ''
            var website = websiteEl && 'value' in websiteEl ? String(websiteEl.value || '') : ''
            function setStatus(msg, ok) {
              if (!statusEl) return
              statusEl.textContent = msg
              statusEl.style.color = ok ? '#3a6b46' : 'var(--accent)'
            }
            if (!email) {
              setStatus('请填写邮箱。', false)
              return
            }
            if (submitEl) submitEl.setAttribute('disabled', 'disabled')
            setStatus('提交中…', true)
            fetch('/api/subscribe', {
              method: 'POST',
              headers: { 'content-type': 'application/json', accept: 'application/json' },
              body: JSON.stringify({ email: email, website: website }),
            })
              .then(function (res) {
                return res.json().then(function (data) {
                  return { res: res, data: data }
                }).catch(function () {
                  return { res: res, data: {} }
                })
              })
              .then(function (out) {
                var data = out.data || {}
                if (out.res.ok && (data.ok === true || data.status === 'duplicate')) {
                  setStatus(data.status === 'duplicate' ? '你已经订阅过了，无需重复提交。' : '已保存。感谢订阅。', true)
                  if (emailEl && 'value' in emailEl) emailEl.value = ''
                  return
                }
                var err = data.error || ''
                if (err === 'invalid_email' || err === 'missing_email') setStatus('邮箱格式不正确，请重试。', false)
                else if (out.res.status === 429) setStatus('提交过于频繁，请稍后再试。', false)
                else if (out.res.status === 503 || err === 'unavailable') setStatus('订阅暂未开放，请稍后再试。', false)
                else setStatus('保存失败，请稍后重试。', false)
              })
              .catch(function () {
                setStatus('网络异常，请稍后重试。', false)
              })
              .finally(function () {
                if (submitEl) submitEl.removeAttribute('disabled')
              })
          })
        }
        bindSubscribe(document.getElementById('subscribe-form'))
        document.querySelectorAll('form[data-subscribe]').forEach(bindSubscribe)
      })()
    </script>
  </body>
</html>
