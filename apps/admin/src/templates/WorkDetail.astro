---
import Layout from '@/layouts/Layout.astro'
import { renderMarkdoc } from '@/lib/markdoc'
import type { SiteSettings, Work } from '@/lib/db/types'
interface Props { settings: SiteSettings; env: any; work: Work }
const { settings, env, work } = Astro.props
const html = renderMarkdoc(work.content_markdoc)
---
<Layout
  settings={settings}
  env={env}
  pathname={`/works/${work.slug}`}
  title={work.title}
  description={work.seo_description ?? work.summary ?? undefined}
  ogImage={work.og_image ?? undefined}
>
  <article class="max-w-3xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold">{work.title}</h1>
    {work.summary && <p class="mt-3 text-lg text-muted-foreground">{work.summary}</p>}
    {work.external_url && <a href={work.external_url} class="inline-block mt-4 underline underline-offset-4">访问 →</a>}
    {work.cover_image && <img src={work.cover_image} alt={work.title} class="rounded my-8 w-full" />}
    <div class="prose prose-invert max-w-none" set:html={html} />
  </article>
</Layout>
