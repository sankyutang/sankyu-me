---
import Layout from '@/layouts/Layout.astro'
import type { SiteSettings } from '@/lib/db/types'
interface Props { settings: SiteSettings; env: any }
const { settings, env } = Astro.props
---
<Layout settings={settings} env={env} pathname="/404" title="Not Found">
  <section class="max-w-3xl mx-auto px-4 py-24 text-center">
    <h1 class="text-5xl font-bold">404</h1>
    <p class="mt-4 text-muted-foreground">Page not found.</p>
    <a href="/" class="mt-6 inline-block underline underline-offset-4">回首页 →</a>
  </section>
</Layout>
