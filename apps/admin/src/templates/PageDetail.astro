---
import Layout from '@/layouts/Layout.astro'
import { renderMarkdoc } from '@/lib/markdoc'
import type { Page, SiteSettings } from '@/lib/db/types'
interface Props { settings: SiteSettings; env: any; page: Page }
const { settings, env, page } = Astro.props
const html = renderMarkdoc(page.content_markdoc)
---
<Layout
  settings={settings}
  env={env}
  pathname={`/${page.slug}`}
  title={page.title}
  description={page.seo_description ?? undefined}
  ogImage={page.og_image ?? undefined}
>
  <article class="max-w-3xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold mb-6">{page.title}</h1>
    <div class="prose prose-invert max-w-none" set:html={html} />
  </article>
</Layout>
