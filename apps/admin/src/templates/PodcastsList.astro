---
import Layout from '@/layouts/Layout.astro'
import type { Podcast, SiteSettings } from '@/lib/db/types'
interface Props { settings: SiteSettings; env: any; podcasts: Podcast[] }
const { settings, env, podcasts } = Astro.props
---
<Layout settings={settings} env={env} pathname="/podcast" title="Podcast">
  <section class="max-w-3xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold mb-8">Podcast</h1>
    <ul class="space-y-6">
      {podcasts.map((p) => (
        <li class="border-b border-border pb-6">
          <a href={`/podcast/${p.slug}`} class="block group">
            <h2 class="text-xl font-semibold group-hover:underline">{p.title}</h2>
            {p.excerpt && <p class="mt-2 text-muted-foreground">{p.excerpt}</p>}
            <div class="mt-2 text-xs text-muted-foreground flex gap-3">
              {p.published_at && <time>{new Date(p.published_at).toISOString().slice(0,10)}</time>}
              {p.duration && <span>· {p.duration}</span>}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
