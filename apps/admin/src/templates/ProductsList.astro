---
import Layout from '@/layouts/Layout.astro'
import type { Product, SiteSettings } from '@/lib/db/types'
interface Props { settings: SiteSettings; env: any; products: Product[] }
const { settings, env, products } = Astro.props
---
<Layout settings={settings} env={env} pathname="/products" title="Products">
  <section class="max-w-3xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold mb-8">Products</h1>
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {products.map((p) => (
        <li class="border border-border rounded p-5">
          <a href={`/products/${p.slug}`} class="block group">
            <h2 class="font-semibold group-hover:underline">{p.name}</h2>
            {p.summary && <p class="text-sm text-muted-foreground mt-1 line-clamp-3">{p.summary}</p>}
            <div class="mt-3 text-xs text-muted-foreground">{p.price_text} · {p.status}</div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
