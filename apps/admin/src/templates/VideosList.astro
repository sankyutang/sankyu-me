---
import Layout from '@/layouts/Layout.astro'
import type { SiteSettings, Video } from '@/lib/db/types'
interface Props { settings: SiteSettings; env: any; videos: Video[] }
const { settings, env, videos } = Astro.props
---
<Layout settings={settings} env={env} pathname="/videos" title="Videos">
  <section class="max-w-3xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold mb-8">Videos</h1>
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {videos.map((v) => (
        <li class="border border-border rounded overflow-hidden">
          <a href={v.video_url ?? '#'} class="block group">
            {v.thumbnail && <img src={v.thumbnail} alt={v.title} class="w-full aspect-video object-cover" />}
            <div class="p-3">
              <div class="font-medium group-hover:underline">{v.title}</div>
              <div class="text-xs text-muted-foreground mt-1">{v.platform}</div>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
