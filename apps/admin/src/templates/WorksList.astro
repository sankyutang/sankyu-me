---
import Layout from '@/layouts/Layout.astro'
import type { SiteSettings, Work } from '@/lib/db/types'
interface Props { settings: SiteSettings; env: any; works: Work[] }
const { settings, env, works } = Astro.props
---
<Layout settings={settings} env={env} pathname="/works" title="Works">
  <section class="max-w-3xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold mb-8">Works</h1>
    <ul class="space-y-6">
      {works.map((w) => (
        <li class="border-b border-border pb-6">
          <a href={w.external_url ?? `/works/${w.slug}`} class="block group">
            <h2 class="text-xl font-semibold group-hover:underline">{w.title}</h2>
            {w.summary && <p class="mt-2 text-muted-foreground">{w.summary}</p>}
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
