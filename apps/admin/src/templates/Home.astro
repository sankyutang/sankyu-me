---
import PaperLayout from '@/layouts/PaperLayout.astro'
import { SocialRow } from '@/components/react/primitives'
import { pageHref, postHref } from '@/lib/links'
import { adaptProfile, adaptSocial, adaptPost, adaptPage } from '@/lib/adapt'
import type { Page, Podcast, Post, Product, SiteSettings, Video } from '@/lib/db/types'

interface Props {
  settings: SiteSettings
  env: { siteUrl: string; assetBase: string }
  posts: Post[]
  products: Product[]
  podcasts: Podcast[]
  videos: Video[]
  pages: Page[]
}
const { settings, env, posts, pages } = Astro.props

const profile = adaptProfile(settings)
const social = adaptSocial(settings)
const adaptedPosts = posts.map((p) => adaptPost(p, env.assetBase))
const allPages = pages.map(adaptPage)
const staticPages = allPages.filter((p) => !p.kind || p.kind === 'static').slice(0, 6)

function formatDate(iso: string): string {
  if (!iso) return ''
  const d = new Date(iso)
  if (Number.isNaN(d.getTime())) return iso.slice(0, 10)
  const y = d.getUTCFullYear()
  const m = String(d.getUTCMonth() + 1).padStart(2, '0')
  const day = String(d.getUTCDate()).padStart(2, '0')
  return `${y}.${m}.${day}`
}

const tags = Array.from(
  new Set(adaptedPosts.map((p) => (p.tag || '文章').trim()).filter(Boolean))
).sort((a, b) => a.localeCompare(b, 'zh-CN'))
---

<PaperLayout settings={settings} env={env} pathname="/" isHome description={profile.intro_zh}>
  <div class="max-w-6xl mx-auto px-5 md:px-8 pt-10 md:pt-12 pb-16">
    <header class="mb-2">
      <hr class="border-0 border-t-2 mb-1" style="border-color: var(--ink-900);" />
      <hr class="hand-divider mt-0 mb-0" />
      <div class="grid md:grid-cols-[1fr_auto] gap-6 md:gap-10 items-end py-7 md:py-8">
        <div>
          <h1 class="font-display text-[2.15rem] md:text-[2.75rem] leading-[1.1]" style="color: var(--ink-900); letter-spacing: 0.08em;">
            {profile.name_zh}
          </h1>
          <p class="mt-2 font-en text-[0.95rem]" style="color: var(--ink-500);">
            {profile.name_en}
          </p>
          <p class="mt-4 text-[1rem] max-w-[36em]" style="color: var(--ink-700); line-height: 1.85;">
            {profile.intro_zh}
          </p>
        </div>
        <div class="font-en text-[0.8125rem] md:text-right" style="color: var(--ink-500); line-height: 1.7;">
          <strong class="block" style="color: var(--ink-800); font-weight: 600;">{profile.location}</strong>
          <span>{profile.title_zh}</span>
        </div>
      </div>
    </header>

    <div class="grid lg:grid-cols-[minmax(0,1fr)_15.5rem] gap-10 lg:gap-12 items-start">
      <section aria-labelledby="home-posts-title">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
          <h2 id="home-posts-title" class="kicker m-0">Latest writing</h2>
          <div class="flex flex-wrap gap-1.5" role="group" aria-label="按标签筛选文章">
            <button type="button" class="filter-btn is-active" data-filter="all" aria-pressed="true">全部</button>
            {tags.map((t) => (
              <button type="button" class="filter-btn" data-filter={t} aria-pressed="false">{t}</button>
            ))}
          </div>
        </div>

        {adaptedPosts.length === 0 ? (
          <p class="py-10 text-[0.95rem]" style="color: var(--ink-500);">暂无已发布文章。</p>
        ) : (
          <ol class="list-none m-0 p-0 border-t" style="border-color: var(--paper-300);" id="home-post-list">
            {adaptedPosts.map((p, i) => (
              <li
                class:list={['home-post', 'py-5', 'md:py-6', 'border-b', i === 0 && 'home-post--lead']}
                style="border-color: var(--paper-300);"
                data-tag={p.tag || '文章'}
              >
                <div class="grid sm:grid-cols-[6.5rem_minmax(0,1fr)] gap-2 sm:gap-5 items-start">
                  <time class="font-en text-[0.75rem] pt-1" style="color: var(--ink-300);" datetime={p.date}>
                    {formatDate(p.date)}
                  </time>
                  <div class="min-w-0">
                    <div class="text-[0.7rem] font-en font-medium tracking-wide mb-1.5" style="color: var(--accent-soft);">
                      {p.tag || '文章'}
                    </div>
                    <h3 class="m-0 font-display text-[1.15rem] md:text-[1.3rem] leading-[1.45]" style="color: var(--ink-900); overflow-wrap: anywhere;">
                      <a href={postHref(p.id)} class="hover:text-[var(--accent-soft)] transition-colors">{p.title_zh}</a>
                    </h3>
                    {p.excerpt && (
                      <p class="mt-2 mb-0 text-[0.925rem]" style="color: var(--ink-500); line-height: 1.8; max-width: 42em;">
                        {p.excerpt}
                      </p>
                    )}
                  </div>
                </div>
              </li>
            ))}
          </ol>
        )}
        <p id="home-filter-empty" class="py-8 text-[0.9rem]" style="color: var(--ink-500); display:none;" hidden>该标签下暂无文章。</p>
        <p class="mt-5 mb-0 text-[0.8125rem]">
          <a href="/posts" class="hand-underline" style="color: var(--ink-500);">查看全部文章 →</a>
        </p>
      </section>

      <aside class="flex flex-col gap-5 lg:sticky lg:top-24" aria-label="侧栏">
        <section class="site-panel">
          <h2 class="kicker mt-0 mb-2">Collaborate</h2>
          <p class="m-0 text-[0.875rem]" style="color: var(--ink-700); line-height: 1.75;">
            AI 咨询、FDE 落地、一人公司与独立产品——可聊主题见关于页。
          </p>
          <ul class="list-none m-3 p-0 text-[0.8125rem]" style="color: var(--ink-500);">
            <li class="py-1.5 border-t" style="border-color: var(--paper-300);">
              <strong class="block" style="color: var(--ink-700); font-weight: 500;">AI 咨询 / FDE</strong>
              工程经验落到小团队工作流
            </li>
            <li class="py-1.5 border-t" style="border-color: var(--paper-300);">
              <strong class="block" style="color: var(--ink-700); font-weight: 500;">一人公司</strong>
              方向、交付与产品生意
            </li>
            <li class="py-1.5 border-t" style="border-color: var(--paper-300);">
              <strong class="block" style="color: var(--ink-700); font-weight: 500;">前端与工程化</strong>
              选型、重构与带队
            </li>
          </ul>
          <a class="site-cta w-full text-center" href="/about">了解更多 →</a>
        </section>

        <section class="site-panel">
          <h2 class="kicker mt-0 mb-3">Elsewhere</h2>
          <div class="flex flex-col gap-2 mb-3">
            {social.map((s) => (
              <a
                href={s.url}
                class="font-en text-[0.8125rem] hand-underline w-fit"
                style="color: var(--ink-700);"
                rel="noopener noreferrer"
                target="_blank"
              >
                {s.label}
              </a>
            ))}
            <a href="/about" class="font-en text-[0.8125rem] hand-underline w-fit" style="color: var(--ink-700);">About</a>
          </div>
          <SocialRow items={social} compact size={32} />
        </section>

        {staticPages.length > 0 && (
          <section class="site-panel">
            <h2 class="kicker mt-0 mb-3">Pages</h2>
            <ul class="list-none m-0 p-0">
              {staticPages.map((p) => (
                <li class="py-1.5 border-t first:border-0" style="border-color: var(--paper-300);">
                  <a href={pageHref(p.id)} class="text-[0.8125rem] hand-underline" style="color: var(--ink-700);">
                    {p.title_zh || p.id}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </aside>
    </div>
  </div>
</PaperLayout>

<style>
  .home-post--lead {
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    margin-left: -0.15rem;
  }
  @media (max-width: 639px) {
    .home-post--lead {
      background: var(--paper-200);
      margin-left: 0;
      padding-left: 0.85rem;
      padding-right: 0.85rem;
      border-left-width: 3px;
    }
  }
</style>

<script is:inline>
  ;(function () {
    var buttons = [].slice.call(document.querySelectorAll('.filter-btn[data-filter]'))
    var posts = [].slice.call(document.querySelectorAll('.home-post'))
    var empty = document.getElementById('home-filter-empty')
    function apply(tag) {
      var n = 0
      posts.forEach(function (el) {
        var match = tag === 'all' || el.getAttribute('data-tag') === tag
        el.hidden = !match
        el.style.display = match ? '' : 'none'
        if (match) n += 1
      })
      if (empty) {
        empty.style.display = n ? 'none' : 'block'
        if (n) empty.setAttribute('hidden', '')
        else empty.removeAttribute('hidden')
      }
    }
    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var tag = btn.getAttribute('data-filter') || 'all'
        buttons.forEach(function (b) {
          var on = b === btn
          b.setAttribute('aria-pressed', on ? 'true' : 'false')
          b.classList.toggle('is-active', on)
        })
        apply(tag)
      })
    })
  })()
</script>
