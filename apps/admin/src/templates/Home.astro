---
import PaperLayout from '@/layouts/PaperLayout.astro'
import { SocialRow } from '@/components/react/primitives'
import { pageHref, postHref } from '@/lib/links'
import { adaptProfile, adaptSocial, adaptPost, adaptPage } from '@/lib/adapt'
import type { Page, Podcast, Post, Product, SiteSettings, Video } from '@/lib/db/types'

interface Props {
  settings: SiteSettings
  env: { siteUrl: string; assetBase: string }
  posts: Post[]
  products: Product[]
  podcasts: Podcast[]
  videos: Video[]
  pages: Page[]
}
const { settings, env, posts, pages } = Astro.props

const profile = adaptProfile(settings)
const social = adaptSocial(settings)
const adaptedPosts = posts.map((p) => adaptPost(p, env.assetBase))
const allPages = pages.map(adaptPage)
const staticPages = allPages.filter((p) => !p.kind || p.kind === 'static').slice(0, 6)

const featured = adaptedPosts[0] || null
const gridPosts = adaptedPosts // show all real posts; featured may repeat in grid

function formatDate(iso: string): string {
  if (!iso) return ''
  const d = new Date(iso)
  if (Number.isNaN(d.getTime())) return iso.slice(0, 10)
  const y = d.getUTCFullYear()
  const m = d.getUTCMonth() + 1
  const day = d.getUTCDate()
  return `${y}年${m}月${day}日`
}

function formatShortDate(iso: string): string {
  if (!iso) return ''
  const d = new Date(iso)
  if (Number.isNaN(d.getTime())) return iso.slice(0, 10)
  const y = d.getUTCFullYear()
  const m = d.getUTCMonth() + 1
  const day = d.getUTCDate()
  if (y < 2020) return `${y}年${m}月${day}日`
  return `${m}月${day}日`
}
---

<PaperLayout settings={settings} env={env} pathname="/" isHome description={profile.intro_zh}>
  {featured ? (
    <section class="featured-band border-b" style="background: var(--paper-200); border-color: var(--paper-300);" aria-label="精选文章">
      <div class="max-w-[67.5rem] mx-auto px-5 md:px-8 py-7 md:py-8 grid md:grid-cols-[1.15fr_1fr] gap-6 md:gap-8 items-center">
        <a class="cover-frame" href={postHref(featured.id)}>
          {featured.cover_src ? (
            <img src={featured.cover_src} width="1200" height="675" alt="" loading="eager" />
          ) : (
            <div class="cover-fallback" aria-hidden="true">
              <p class="cf-title">{featured.title_zh}</p>
              <span class="cf-note">排版封面 · 本文无独立封面图</span>
            </div>
          )}
        </a>
        <div class="min-w-0">
          <a
            href={postHref(featured.id)}
            class="font-display font-bold text-[1.35rem] md:text-[1.75rem] leading-[1.35] no-underline block"
            style="color: var(--ink-900); overflow-wrap: anywhere;"
          >
            {featured.title_zh}
          </a>
          {featured.excerpt && (
            <p class="mt-3 mb-0 text-[0.98rem]" style="color: var(--ink-500); line-height: 1.75;">
              {featured.excerpt}
            </p>
          )}
          <p class="mt-4 mb-0 text-[0.82rem]" style="color: var(--ink-300);">
            {formatDate(featured.date)} · {profile.name_zh}
          </p>
        </div>
      </div>
    </section>
  ) : null}

  <div class="max-w-[67.5rem] mx-auto px-5 md:px-8 py-8 md:py-10 grid lg:grid-cols-[minmax(0,1fr)_16rem] gap-10 lg:gap-12 items-start">
    <section aria-labelledby="home-posts-title">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
        <h2 id="home-posts-title" class="m-0 font-display font-bold text-[1.25rem]" style="color: var(--ink-900);">
          最新文章
        </h2>
        <a href="/posts" class="text-[0.9rem] no-underline" style="color: var(--ink-500);">查看全部</a>
      </div>

      {gridPosts.length === 0 ? (
        <p class="py-10 text-[0.95rem]" style="color: var(--ink-500);">暂无已发布文章。</p>
      ) : (
        <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-x-5 gap-y-8">
          {gridPosts.map((p) => (
            <article class="min-w-0">
              <a class="cover-frame" href={postHref(p.id)}>
                {p.cover_src ? (
                  <img src={p.cover_src} width="800" height="450" alt="" loading="lazy" />
                ) : (
                  <div class="cover-fallback" aria-hidden="true">
                    <p class="cf-title">{p.title_zh}</p>
                    <span class="cf-note">排版封面 · 本文无独立封面图</span>
                  </div>
                )}
              </a>
              <h3 class="mt-3 mb-0 font-display font-bold text-[1.02rem] leading-[1.4]" style="overflow-wrap: anywhere;">
                <a href={postHref(p.id)} class="no-underline" style="color: var(--ink-900);">{p.title_zh}</a>
              </h3>
              {p.excerpt && (
                <p class="mt-2 mb-0 text-[0.9rem]" style="color: var(--ink-500); line-height: 1.65; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                  {p.excerpt}
                </p>
              )}
              <p class="mt-2.5 mb-0 text-[0.8rem]" style="color: var(--ink-300);">
                {formatShortDate(p.date)} · {profile.name_zh}
              </p>
            </article>
          ))}
        </div>
      )}

      <div class="text-center mt-10">
        <a
          href="/posts"
          class="inline-flex px-5 py-2.5 rounded-full text-[0.9rem] font-medium no-underline"
          style="background: var(--paper-200); color: var(--ink-900);"
        >
          查看全部
        </a>
      </div>
    </section>

    <aside class="flex flex-col gap-8 lg:sticky lg:top-24" aria-label="关于作者">
      <section>
        <div class="w-12 h-12 rounded-full mb-3 overflow-hidden" aria-hidden="true">
          <div class="avatar-mark text-[1rem]">桥</div>
        </div>
        <h2 class="m-0 font-display font-bold text-[1.05rem]" style="color: var(--ink-900);">{profile.name_zh}</h2>
        <p class="mt-2 mb-0 text-[0.88rem]" style="color: var(--ink-500); line-height: 1.7;">
          {profile.intro_zh}
        </p>
      </section>

      <section class="pt-6 border-t" style="border-color: var(--paper-300);">
        <h3 class="m-0 mb-2 font-display font-bold text-[0.95rem]" style="color: var(--ink-900);">关于与合作</h3>
        <p class="m-0 text-[0.88rem]" style="color: var(--ink-500); line-height: 1.7;">
          AI 咨询、独立产品、FDE 落地、一人公司课程。需要时从关于页了解背景。
        </p>
        <a class="btn-cta block mt-4" href="/about">前往关于页</a>
        <div class="mt-4">
          <SocialRow items={social} compact size={32} />
        </div>
      </section>

      <section class="pt-6 border-t" style="border-color: var(--paper-300);">
        <h3 class="m-0 mb-2 font-display font-bold text-[0.95rem]" style="color: var(--ink-900);">订阅更新</h3>
        <p class="m-0 mb-3 text-[0.88rem]" style="color: var(--ink-500); line-height: 1.65;">
          留下邮箱，接收一人公司相关更新。
        </p>
        <form data-subscribe class="subscribe-form flex flex-col gap-2" novalidate>
          <div class="flex flex-col gap-2">
            <input
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="your@email"
              class="subscribe-input w-full px-3 py-2 text-[0.875rem]"
              style="background: var(--paper-50); border: 1px solid var(--paper-300); color: var(--ink-800); border-radius: 999px;"
            />
            <button type="submit" class="btn-cta w-full">订阅</button>
          </div>
          <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;height:0;width:0;" />
          <p data-subscribe-status class="text-[0.78rem] m-0" style="color: var(--ink-300); min-height: 1.2em;" role="status" aria-live="polite"></p>
        </form>
      </section>

      {staticPages.length > 0 && (
        <section class="pt-6 border-t" style="border-color: var(--paper-300);">
          <h3 class="m-0 mb-3 font-display font-bold text-[0.95rem]" style="color: var(--ink-900);">页面</h3>
          <ul class="list-none m-0 p-0">
            {staticPages.map((p) => (
              <li class="py-1.5">
                <a href={pageHref(p.id)} class="text-[0.88rem] hand-underline" style="color: var(--ink-700);">
                  {p.title_zh || p.id}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </aside>
  </div>
</PaperLayout>
