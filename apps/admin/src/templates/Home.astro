---
import Layout from '@/layouts/Layout.astro'
import type { Podcast, Post, Product, SiteSettings, Video } from '@/lib/db/types'

interface Props {
  settings: SiteSettings
  env: { siteUrl: string; assetBase: string }
  posts: Post[]
  products: Product[]
  podcasts: Podcast[]
  videos: Video[]
}
const { settings, env, posts, products, podcasts, videos } = Astro.props

const featuredPosts = posts.filter((p) => p.featured).slice(0, 3).concat(
  posts.filter((p) => !p.featured).slice(0, Math.max(0, 5 - posts.filter((p) => p.featured).length))
).slice(0, 5)
const featuredProducts = products.filter((p) => p.featured).concat(products.filter((p) => !p.featured)).slice(0, 4)
---
<Layout settings={settings} env={env} pathname="/" isHome={true}>
  <section class="max-w-3xl mx-auto px-4 pt-16 pb-12">
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight">{settings.introHeadline || settings.siteName}</h1>
    {settings.introBody && <p class="mt-4 text-muted-foreground leading-relaxed whitespace-pre-line">{settings.introBody}</p>}
    {settings.socialLinks?.length > 0 && (
      <div class="mt-6 flex gap-4 text-sm">
        {settings.socialLinks.map((s) => <a href={s.url} class="underline underline-offset-4">{s.platform}</a>)}
      </div>
    )}
  </section>

  {featuredPosts.length > 0 && (
    <section class="max-w-3xl mx-auto px-4 py-8">
      <div class="flex items-baseline justify-between mb-4">
        <h2 class="text-xl font-semibold">最新文章</h2>
        <a href="/blog" class="text-sm text-muted-foreground">查看全部 →</a>
      </div>
      <ul class="space-y-3">
        {featuredPosts.map((p) => (
          <li>
            <a href={`/blog/${p.slug}`} class="block hover:bg-muted/40 -mx-2 px-2 py-2 rounded">
              <div class="font-medium">{p.title}</div>
              {p.excerpt && <div class="text-sm text-muted-foreground line-clamp-2">{p.excerpt}</div>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {featuredProducts.length > 0 && (
    <section class="max-w-3xl mx-auto px-4 py-8">
      <div class="flex items-baseline justify-between mb-4">
        <h2 class="text-xl font-semibold">产品</h2>
        <a href="/products" class="text-sm text-muted-foreground">查看全部 →</a>
      </div>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {featuredProducts.map((p) => (
          <li class="border border-border rounded p-4">
            <a href={`/products/${p.slug}`} class="font-medium hover:underline">{p.name}</a>
            {p.summary && <p class="text-sm text-muted-foreground mt-1 line-clamp-2">{p.summary}</p>}
          </li>
        ))}
      </ul>
    </section>
  )}

  {(podcasts.length > 0 || videos.length > 0) && (
    <section class="max-w-3xl mx-auto px-4 py-8 grid grid-cols-1 sm:grid-cols-2 gap-8">
      {podcasts.length > 0 && (
        <div>
          <h2 class="text-xl font-semibold mb-3">播客</h2>
          <ul class="space-y-2 text-sm">
            {podcasts.slice(0, 3).map((p) => (
              <li><a href={`/podcast/${p.slug}`} class="hover:underline">{p.title}</a></li>
            ))}
          </ul>
        </div>
      )}
      {videos.length > 0 && (
        <div>
          <h2 class="text-xl font-semibold mb-3">视频</h2>
          <ul class="space-y-2 text-sm">
            {videos.slice(0, 3).map((v) => (
              <li><a href={v.video_url ?? '#'} class="hover:underline">{v.title}</a></li>
            ))}
          </ul>
        </div>
      )}
    </section>
  )}
</Layout>
