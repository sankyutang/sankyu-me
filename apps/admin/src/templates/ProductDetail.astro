---
import Layout from '@/layouts/Layout.astro'
import { renderMarkdoc } from '@/lib/markdoc'
import type { Product, SiteSettings } from '@/lib/db/types'
interface Props { settings: SiteSettings; env: any; product: Product }
const { settings, env, product } = Astro.props
const html = renderMarkdoc(product.content_markdoc)
---
<Layout
  settings={settings}
  env={env}
  pathname={`/products/${product.slug}`}
  title={product.name}
  description={product.seo_description ?? product.summary ?? undefined}
  ogImage={product.og_image ?? undefined}
>
  <article class="max-w-3xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold">{product.name}</h1>
    {product.summary && <p class="mt-3 text-lg text-muted-foreground">{product.summary}</p>}
    <div class="mt-4 flex items-center gap-3">
      {product.price_text && <span class="font-medium">{product.price_text}</span>}
      {product.external_url && (
        <a href={product.external_url} class="px-4 py-2 bg-primary text-primary-foreground rounded text-sm">{product.cta_text || 'Get it'}</a>
      )}
    </div>
    {product.cover_image && <img src={product.cover_image} alt={product.name} class="rounded my-8 w-full" />}
    {product.highlights.length > 0 && (
      <section class="my-8">
        <h2 class="text-xl font-semibold mb-4">亮点</h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {product.highlights.map((h) => (
            <li class="border border-border rounded p-4">
              <div class="font-medium">{h.title}</div>
              <div class="text-sm text-muted-foreground mt-1">{h.description}</div>
            </li>
          ))}
        </ul>
      </section>
    )}
    <div class="prose prose-invert max-w-none" set:html={html} />
    {product.faq.length > 0 && (
      <section class="my-10">
        <h2 class="text-xl font-semibold mb-4">FAQ</h2>
        <dl class="space-y-4">
          {product.faq.map((f) => (
            <div>
              <dt class="font-medium">{f.question}</dt>
              <dd class="text-muted-foreground mt-1">{f.answer}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}
  </article>
</Layout>
