---
import PaperLayout from '@/layouts/PaperLayout.astro'
import VideosDetail from '@/components/react/VideosDetail'
import { getSiteSettings, listVideos } from '@/lib/db/queries'
import { adaptVideo, absoluteAssetUrl } from '@/lib/adapt'

const env = Astro.locals.runtime.env
const { slug } = Astro.params
const settings = await getSiteSettings(env.DB)
const envProps = { siteUrl: env.SITE_BASE_URL, assetBase: env.ASSET_BASE_URL }

const rows = await listVideos(env.DB, { status: 'published' })
const row = rows.find((v) => v.slug === slug)
if (!row) return new Response('Not found', { status: 404 })
const all = rows.map(adaptVideo)
const video = adaptVideo(row)
const related = all.filter((x) => x.id !== video.id).slice(0, 5)
const ogImage = absoluteAssetUrl(env.SITE_BASE_URL, env.ASSET_BASE_URL, row.thumbnail)
---

<PaperLayout settings={settings} env={envProps} pathname={`/media/videos/${slug}`} title={video.title} description={video.desc} ogImage={ogImage}>
  <VideosDetail video={video} related={related} />
</PaperLayout>
