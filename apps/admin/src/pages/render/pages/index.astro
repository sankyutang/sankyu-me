---
import PaperLayout from '@/layouts/PaperLayout.astro'
import ListShell from '@/components/ListShell.astro'
import { PageTopicCard, PageCollectionCard } from '@/components/react/pagebits'
import { PageRow } from '@/components/react/cards'
import { getSiteSettings, listPages } from '@/lib/db/queries'
import { adaptPage } from '@/lib/adapt'

const env = Astro.locals.runtime.env
const settings = await getSiteSettings(env.DB)
const envProps = { siteUrl: env.SITE_BASE_URL, assetBase: env.ASSET_BASE_URL }
const pages = (await listPages(env.DB)).map(adaptPage)
const topics = pages.filter((p) => p.kind === 'topic')
const collections = pages.filter((p) => p.kind === 'collection')
const statics = pages.filter((p) => !p.kind || p.kind === 'static')
---

<PaperLayout settings={settings} env={envProps} pathname="/pages" title="Pages" description="专题、合集与独立页面。">
  <ListShell
    kicker="Pages"
    en="页面"
    blurb={pages.length ? '专题、合集与独立小页。' : undefined}
    count={pages.length || null}
    wide
  >
    {pages.length === 0 ? (
      <p class="text-[0.95rem]" style="color: var(--ink-700); line-height: 1.75;">暂无公开页面。</p>
    ) : (
      <>
        {topics.length > 0 && (
          <section id="sec-topics" class="mb-12 scroll-mt-24">
            <h2 class="font-display text-[1.25rem] mb-4" style="color: var(--ink-900);">专题</h2>
            <div class="grid md:grid-cols-3 gap-5">{topics.map((t) => <PageTopicCard page={t} />)}</div>
          </section>
        )}

        {collections.length > 0 && (
          <section id="sec-collections" class="mb-12 scroll-mt-24">
            <h2 class="font-display text-[1.25rem] mb-4" style="color: var(--ink-900);">合集</h2>
            <div class="grid md:grid-cols-2 gap-5">{collections.map((c) => <PageCollectionCard page={c} />)}</div>
          </section>
        )}

        {statics.length > 0 && (
          <section id="sec-static" class="scroll-mt-24">
            <h2 class="font-display text-[1.25rem] mb-4" style="color: var(--ink-900);">独立页面</h2>
            <div class="grid md:grid-cols-2 gap-x-10">{statics.map((p) => <PageRow p={p} />)}</div>
          </section>
        )}
      </>
    )}
  </ListShell>
</PaperLayout>
