---
import PaperLayout from '@/layouts/PaperLayout.astro'
import { Avatar, SocialRow } from '@/components/react/primitives'
import { getSiteSettings } from '@/lib/db/queries'
import { adaptProfile, adaptSocial } from '@/lib/adapt'

const env = Astro.locals.runtime.env
const settings = await getSiteSettings(env.DB)
const envProps = { siteUrl: env.SITE_BASE_URL, assetBase: env.ASSET_BASE_URL }
const profile = adaptProfile(settings)
const social = adaptSocial(settings)

const timeline = [
  { year: '2024', title: '开始一人公司', desc: '现为 OPC 一人公司，独立开发者，FDE。' },
  { year: '2021', title: '加入六一科技&欢乐童年', desc: '担任前端技术副总监，至 2023 年 11 月离职。' },
  { year: '2019', title: '加入深圳初柒科技文化有限公司', desc: '担任前端主管，至 2021 年 2 月。' },
  { year: '2015', title: '加入阿里巴巴', desc: '在 UC 事业群国际研发部任前端开发专家，至 2019 年 4 月。' },
  { year: '2014', title: '出版《HTML5 移动开发指南》', desc: '一本前端著作。' },
  { year: '2012', title: '加入优视科技', desc: '在 UC 浏览器中间件部任前端开发工程师，至 2015 年 1 月。' },
  { year: '2011', title: '加入优乐无线&纵贯科技', desc: '任前端开发工程师，至 2012 年 4 月。' },
  { year: '2008', title: '加入广东同望科技', desc: '在广州研发部任软件经理，至 2011 年 1 月。' },
  { year: '2006', title: '就读华南师范大学', desc: '计算机科学与技术硕士，2008 年毕业。' },
]
const meta = [
  { k: '现居', v: 'China, Guangzhou' },
  { k: '职业', v: 'OPC一人公司，独立开发者，FDE' },
  { k: '前职', v: '大厂前端P7 & 前端总监' },
  { k: '在做', v: 'AI咨询、独立产品、FDE落地、一人公司课程' },
]
const talk = [
  { t: 'AI 咨询 / FDE 落地', d: '把大厂前端和工程经验，落到一人团队的 AI 编程工作流。' },
  { t: '一人公司 / 独立产品', d: '从方向、定价到交付，怎么把产品做成一门生意。' },
  { t: '前端团队与工程化', d: '技术选型、重构、跨团队协作，以及带前端团队。' },
  { t: '一人公司课程', d: '面向想做独立开发或一人公司的同行，分享可复用的方法。' },
]
---

<PaperLayout settings={settings} env={envProps} pathname="/about" title="About" description={profile.intro_zh}>
  <div class="max-w-4xl mx-auto px-5 md:px-8 pt-12 md:pt-16 pb-16">
    <header class="reveal mb-12 md:mb-16 grid md:grid-cols-[180px_1fr] gap-8 md:gap-12 items-start">
      <Avatar size={160} initial={profile.avatar_initial} />
      <div>
        <div class="kicker mb-2">关于 · ABOUT</div>
        <h1 class="font-display text-[44px] md:text-[60px] leading-[0.98]" style="color: var(--ink-900);">你好, 我是 <span style="color: var(--accent);">{profile.name_zh}</span>。</h1>
        <p class="mt-2 italic text-[20px]" style="color: var(--ink-500); font-family: var(--font-serif-en);">Hi, I'm {profile.name_en}.</p>
        <p class="mt-5 text-[16px]" style="color: var(--ink-700); line-height: 1.8;">{profile.intro_zh}</p>
      </div>
    </header>

    <hr class="hand-divider mb-12" />

    <section class="reveal mb-14 grid md:grid-cols-4 gap-6 text-[14px]">
      {meta.map((m) => (
        <div>
          <div class="kicker mb-1">{m.k}</div>
          <div style="color: var(--ink-800);">{m.v}</div>
        </div>
      ))}
    </section>

    <section class="reveal mb-14">
      <h2 class="font-display text-[28px] md:text-[34px] mb-6" style="color: var(--ink-900);">时间线 <span class="italic ml-2 text-[18px]" style="color: var(--ink-500); font-family: var(--font-serif-en); font-weight: 400;">· Timeline</span></h2>
      <div class="grid gap-6 md:gap-4">
        {timeline.map((t) => (
          <div class="grid grid-cols-[80px_1fr] gap-5 pb-5 border-b" style="border-color: var(--ink-300);">
            <div class="num-stamp text-[28px] leading-none">{t.year}</div>
            <div>
              <h4 class="font-display text-[18px]" style="color: var(--ink-900);">{t.title}</h4>
              <p class="text-[14px] mt-1" style="color: var(--ink-700); line-height: 1.7;">{t.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="reveal mb-14">
      <h2 class="font-display text-[28px] md:text-[34px] mb-6" style="color: var(--ink-900);">能聊些什么 <span class="italic ml-2 text-[18px]" style="color: var(--ink-500); font-family: var(--font-serif-en); font-weight: 400;">· What I can talk about</span></h2>
      <div class="grid md:grid-cols-2 gap-5">
        {talk.map((x) => (
          <div class="paper-card p-5">
            <h4 class="font-display text-[18px] mb-1" style="color: var(--ink-900);">{x.t}</h4>
            <p class="text-[14px]" style="color: var(--ink-700); line-height: 1.7;">{x.d}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="reveal">
      <h2 class="font-display text-[28px] md:text-[34px] mb-6" style="color: var(--ink-900);">常用平台 <span class="italic ml-2 text-[18px]" style="color: var(--ink-500); font-family: var(--font-serif-en); font-weight: 400;">· Platforms</span></h2>
      <div class="paper-card p-6"><SocialRow items={social} /></div>
    </section>
  </div>
</PaperLayout>
