---
import PaperLayout from '@/layouts/PaperLayout.astro'
import { SocialRow } from '@/components/react/primitives'
import { getSiteSettings } from '@/lib/db/queries'
import { adaptProfile, adaptSocial } from '@/lib/adapt'

const env = Astro.locals.runtime.env
const settings = await getSiteSettings(env.DB)
const envProps = { siteUrl: env.SITE_BASE_URL, assetBase: env.ASSET_BASE_URL }
const profile = adaptProfile(settings)
const social = adaptSocial(settings)

const timeline = [
  { year: '2024', title: '开始一人公司', desc: '现为 OPC 一人公司，独立开发者，FDE。' },
  { year: '2021', title: '加入六一科技&欢乐童年', desc: '担任前端技术副总监，至 2023 年 11 月离职。' },
  { year: '2019', title: '加入深圳初柒科技文化有限公司', desc: '担任前端主管，至 2021 年 2 月。' },
  { year: '2015', title: '加入阿里巴巴', desc: '在 UC 事业群国际研发部任前端开发专家，至 2019 年 4 月。' },
  { year: '2014', title: '出版《HTML5 移动开发指南》', desc: '一本前端著作。' },
  { year: '2012', title: '加入优视科技', desc: '在 UC 浏览器中间件部任前端开发工程师，至 2015 年 1 月。' },
  { year: '2011', title: '加入优乐无线&纵贯科技', desc: '任前端开发工程师，至 2012 年 4 月。' },
  { year: '2008', title: '加入广东同望科技', desc: '在广州研发部任软件经理，至 2011 年 1 月。' },
  { year: '2006', title: '就读华南师范大学', desc: '计算机科学与技术硕士，2008 年毕业。' },
]
const meta = [
  { k: '现居', v: 'China, Guangzhou' },
  { k: '职业', v: 'OPC一人公司，独立开发者，FDE' },
  { k: '前职', v: '大厂前端P7 & 前端总监' },
  { k: '在做', v: 'AI咨询、独立产品、FDE落地、一人公司课程' },
]
const talk = [
  { t: 'AI 咨询 / FDE 落地', d: '把大厂前端和工程经验，落到一人团队的 AI 编程工作流。' },
  { t: '一人公司 / 独立产品', d: '从方向、定价到交付，怎么把产品做成一门生意。' },
  { t: '前端团队与工程化', d: '技术选型、重构、跨团队协作，以及带前端团队。' },
  { t: '一人公司课程', d: '面向想做独立开发或一人公司的同行，分享可复用的方法。' },
]
---

<PaperLayout settings={settings} env={envProps} pathname="/about" title="About" description={profile.intro_zh}>
  <div class="max-w-3xl mx-auto px-5 md:px-8 pt-10 md:pt-12 pb-16">
    <header class="mb-10 md:mb-12">
      <div class="kicker mb-2">About</div>
      <h1 class="font-display font-bold text-[2rem] md:text-[2.4rem] leading-[1.2]" style="color: var(--ink-900);">
        你好，我是 {profile.name_zh}
      </h1>
      <p class="mt-2 font-en text-[1rem]" style="color: var(--ink-500);">Hi, I'm {profile.name_en}.</p>
      <p class="mt-5 text-[1rem]" style="color: var(--ink-700); line-height: 1.85;">{profile.intro_zh}</p>
    </header>

    <hr class="hand-divider mb-10" />

    <section class="mb-12 grid sm:grid-cols-2 gap-x-8 gap-y-5 text-[0.9rem]">
      {meta.map((m) => (
        <div>
          <div class="kicker mb-1">{m.k}</div>
          <div style="color: var(--ink-800); line-height: 1.6;">{m.v}</div>
        </div>
      ))}
    </section>

    <section class="mb-12">
      <h2 class="font-display text-[1.35rem] md:text-[1.5rem] mb-5" style="color: var(--ink-900);">
        时间线 <span class="font-en text-[0.85rem] font-medium ml-2" style="color: var(--ink-500);">Timeline</span>
      </h2>
      <div class="grid gap-0">
        {timeline.map((t) => (
          <div class="grid grid-cols-[4.5rem_minmax(0,1fr)] gap-4 py-4 border-b" style="border-color: var(--paper-300);">
            <div class="num-stamp text-[1.15rem] pt-0.5">{t.year}</div>
            <div class="min-w-0">
              <h3 class="font-display text-[1.05rem] m-0" style="color: var(--ink-900);">{t.title}</h3>
              <p class="text-[0.875rem] mt-1 mb-0" style="color: var(--ink-700); line-height: 1.7;">{t.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-12">
      <h2 class="font-display text-[1.35rem] md:text-[1.5rem] mb-5" style="color: var(--ink-900);">
        能聊些什么 <span class="font-en text-[0.85rem] font-medium ml-2" style="color: var(--ink-500);">Topics</span>
      </h2>
      <div class="grid gap-4">
        {talk.map((x) => (
          <div class="py-3 border-b" style="border-color: var(--paper-300);">
            <h3 class="font-display text-[1.05rem] m-0 mb-1" style="color: var(--ink-900);">{x.t}</h3>
            <p class="text-[0.875rem] m-0" style="color: var(--ink-700); line-height: 1.7;">{x.d}</p>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2 class="font-display text-[1.35rem] md:text-[1.5rem] mb-5" style="color: var(--ink-900);">
        常用平台 <span class="font-en text-[0.85rem] font-medium ml-2" style="color: var(--ink-500);">Platforms</span>
      </h2>
      <SocialRow items={social} />
    </section>
  </div>
</PaperLayout>
